# Godot
game/.godot/
game/native/*.dll
game/native/*.so
game/native/*.a
game/native/*.exp
game/native/*.lib
builds/
.itchio-api-key

# Native build
native/third_party/
native/extension_api.json
native/.sconsign.dblite
native/build.log
native/src/**/*.o
native/src/*.o

# Art scratch
art/team/**/_zoom/
art/review/sheets/_*.png
__pycache__/

# Review renders (sheets, in-engine previews, captures) are local working output, not committed
art/review/**/*.png
art/review/**/*.png.log

# Large video files (trailers and captures) stay local.
*.mp4
*.m4v
*.mov
*.mkv
*.avi
*.webm
*.wmv
*.mpeg
*.mpg
*.ogv

# Native build logs from parallel builds (build_lead.log, build_m.log, ...)
native/build*.log

# World rework working output: sweep dumps, run logs, diagnostic captures. Scripts, notes and the
# final ship captures (art/team/world/final/*.png, final/cine/*.png) are committed.
art/team/world/**/*.log
art/team/world/**/*.jsonl
art/team/world/**/*.txt
art/team/world/**/*.err
art/team/world/**/*.out
art/team/world/stage0/**/*.png
art/team/world/stage0/geo*/
art/team/world/houses/*.png