[configuration]

entry_symbol = "totnative_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://native/totnative.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/totnative.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://native/libtotnative.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/libtotnative.linux.template_release.x86_64.so"
