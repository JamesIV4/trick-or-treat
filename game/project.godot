; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Halloween: Trick or Treat!"
config/description="A cozy low-poly collect-a-thon in a procedurally generated moonlit Halloween neighborhood."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Boot="*res://scripts/boot.gd"
Settings="*res://scripts/settings.gd"
Saves="*res://scripts/saves.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Trick or Treat"

[editor_plugins]

enabled=PackedStringArray("res://addons/sound_board/plugin.cfg")

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
environment/ssao/quality=4
environment/ssao/half_size=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.15, 1)

[shader_globals]

cutout_from={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cutout_to={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cutout_radius={
"type": "float",
"value": 0.0
}
